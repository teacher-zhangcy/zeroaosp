diff --git a/private/dsh_quickjsd.te b/private/dsh_quickjsd.te
new file mode 100644
index 0000000..dea8d16
--- /dev/null
+++ b/private/dsh_quickjsd.te
@@ -0,0 +1,30 @@
+# dsh_quickjsd — zeroaosp 插件运行时守护进程（M2 起承载 QuickJS 插件宿主）
+#
+# 为什么要独立域：它是常驻、需要向 servicemanager 注册、并被插件客户端调用的系统服务；
+# 既不属于 system_server，也不应复用 shell/su 这类过宽的域。AOSP 惯例：新守护进程 = 新域，
+# 类型命名 <daemon> / <daemon>_exec / <daemon>_service（对照 private/dnsmasq.te、private/statsd.te）。
+#
+# 命名说明：域取 dsh_quickjsd（M2 的插件运行时守护进程）；M1 冒烟服务 dsh_hello_service 是它的
+# 先行替身，正式二进制落 /system/bin/dsh_quickjsd，服务名在改名补丁落地前沿用 dsh_hello_service。
+
+typeattribute dsh_quickjsd coredomain;
+
+# init 起进程时做域转换（展开为 domain_auto_trans(init, dsh_quickjsd_exec, dsh_quickjsd)）
+init_daemon_domain(dsh_quickjsd)
+
+# 与 servicemanager 通信并注册我们的服务；
+# add_service 宏自带 neverallow：除 dsh_quickjsd 外任何域都不许向 dsh_quickjsd_service 上 add
+binder_use(dsh_quickjsd)
+add_service(dsh_quickjsd, dsh_quickjsd_service)
+
+# 服务被调用 / 被 dump：M1/M2 的观测手段是 adb shell 的 service list 与 dumpsys，
+# 正式形态下由具体客户端域承担（此处先只开 shell，范围最小）
+allow shell dsh_quickjsd_service:service_manager find;
+allow shell dsh_quickjsd_service:binder { call transfer };
+
+# 读/执行自己的可执行文件
+allow dsh_quickjsd dsh_quickjsd_exec:file rx_file_perms;
+
+# 基础运行：binder 线程池需要 fork，自身 binder 对象需要 call/transfer
+allow dsh_quickjsd self:process fork;
+allow dsh_quickjsd self:binder { call transfer };
\ No newline at end of file
