+++ b/services/java/com/android/server/ZeroAospPluginAssembler.java
@@ -0,0 +1,29 @@
+/*
+ * zeroaosp P-01 骨架：插件装配器。
+ * M2 目标是在此完成"发现 → 装配 → 就绪"的状态迁移，并让状态可被 dumpsys 查询。
+ * 当前版本只做两件事：读注册表 + 打印条目数，供 M2 后续替换实现。
+ */
+package com.android.server;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.provider.Settings;
+import android.util.Slog;
+
+/** @hide */
+public final class ZeroAospPluginAssembler {
+    private static final String TAG = "ZeroAospPluginAssembler";
+
+    private ZeroAospPluginAssembler() {}
+
+    /** 由 SystemServer 在 PMS 就绪后调用；当前只读注册表并记录条目是否存在。 */
+    public static void assemble(Context systemContext) {
+        ContentResolver cr = systemContext.getContentResolver();
+        String registry = Settings.Global.getZeroAospPluginRegistry(cr);
+        if (registry == null || registry.isEmpty()) {
+            Slog.i(TAG, "zeroaosp: plugin registry empty (assembled=0)");
+            return;
+        }
+        Slog.i(TAG, "zeroaosp: plugin registry present, bytes=" + registry.length());
+    }
+}
\ No newline at end of file
