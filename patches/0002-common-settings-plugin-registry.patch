diff --git a/core/java/android/provider/Settings.java b/core/java/android/provider/Settings.java
index d695c0c..9057286 100644
--- a/core/java/android/provider/Settings.java
+++ b/core/java/android/provider/Settings.java
@@ -11723,7 +11723,29 @@ public final class Settings {
      * explicitly modify through the system UI or specialized APIs for those values.
      */
     public static final class Global extends NameValueTable {
-        // NOTE: If you add new settings here, be sure to add them to
+
+        /**
+         * zeroaosp P-03：插件注册表的持久化条目名。
+         * 表内值是装配器可读的 JSON 文本（条目数组：id / 路径 / 状态）。
+         * @hide
+         */
+        public static final String ZEROAOSP_PLUGIN_REGISTRY = "zeroaosp_plugin_registry";
+
+        /**
+         * zeroaosp P-03：读取插件注册表（只读通路）。未写入过时返回 null。
+         * @hide
+         */
+        public static String getZeroAospPluginRegistry(ContentResolver cr) {
+            return getString(cr, ZEROAOSP_PLUGIN_REGISTRY);
+        }
+
+        /**
+         * zeroaosp P-03：最小写入通路（由 SettingsProvider 的既有权限校验负责鉴权）。
+         * @hide
+         */
+        public static boolean putZeroAospPluginRegistry(ContentResolver cr, String json) {
+            return putString(cr, ZEROAOSP_PLUGIN_REGISTRY, json);
+        }        // NOTE: If you add new settings here, be sure to add them to
         // com.android.providers.settings.SettingsProtoDumpUtil#dumpProtoGlobalSettingsLocked.
 
         /**
