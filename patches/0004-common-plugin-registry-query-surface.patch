+/*
+ * zeroaosp P-04 骨架：插件注册表的**只读查询面**。
+ * 为什么需要它：注册表写进 Settings 之后，只有 SettingsProvider 内部可见；
+ * 给 M2 的观测（G1/G4）一个能 `dumpsys` / `service call` 读到的稳定出口，
+ * 才能在 enforcing 的 userdebug 镜像上"自证"装配状态，而不是靠截图。
+ * 本类只读、不写、不持有状态（每次 dump 现读 Settings）。
+ */
+package com.android.server;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.os.Binder;
+import android.provider.Settings;
+import android.util.Slog;
+
+/** @hide */
+public final class ZeroAospPluginRegistryService extends Binder {
+    private static final String TAG = "ZeroAospPluginRegistry";
+
+    /** service 名字：`adb shell service list | grep zeroaosp` 可查。 */
+    public static final String SERVICE_NAME = "zeroaosp_plugin_registry";
+
+    private final Context mContext;
+
+    public ZeroAospPluginRegistryService(Context context) {
+        mContext = context;
+        attachInterface(null, SERVICE_NAME);
+    }
+
+    /** 注册到 servicemanager。由 SystemServer 在 PMS 就绪后调用。 */
+    public static void start(Context systemContext) {
+        try {
+            android.os.ServiceManager.addService(SERVICE_NAME,
+                    new ZeroAospPluginRegistryService(systemContext));
+            Slog.i(TAG, "registry query surface registered as " + SERVICE_NAME);
+        } catch (Throwable e) {
+            Slog.w(TAG, "registry query surface registration failed", e);
+        }
+    }
+
+    @Override
+    protected void dump(java.io.FileDescriptor fd, java.io.PrintWriter pw, String[] args) {
+        ContentResolver cr = mContext.getContentResolver();
+        String registry = Settings.Global.getZeroAospPluginRegistry(cr);
+        pw.println("zeroaosp plugin registry (read-only surface)");
+        if (registry == null || registry.isEmpty()) {
+            pw.println("  entries=0 state=EMPTY");
+            return;
+        }
+        pw.println("  bytes=" + registry.length());
+        pw.println("  raw=" + registry);
+    }
+}
